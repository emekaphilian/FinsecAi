# --- Backend ---
DATABASE_URL=postgresql+psycopg2://finsecai:finsecai@localhost:5432/finsecai
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14
# Set to production in every deployed environment: disables SQLite fallback.
ENVIRONMENT=development
# AML compliance defaults; confirm current regulatory guidance before production use.
AUDIT_RETENTION_YEARS=5
STR_REPORTING_SLA_HOURS=24
STR_RISK_THRESHOLD=0.85
# Existing/unknown roles are least-privilege (`analyst` / no permissions) until
# explicitly assigned one of: admin, compliance_officer, analyst, viewer.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://finsec-ai.vercel.app
SEED_DEMO_DATA=true
# Deterministic platform owner bootstrap. Created only when no owner exists.
OWNER_EMAIL=owner@finsecai.com
OWNER_PASSWORD=123

# LLM providers (all optional — the app falls back to a templated summary if none are set)
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-plus-05-2026
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIMENSION=1536
COHERE_TEMPERATURE=0.1
COHERE_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER_ORDER=cohere,openai
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSION=1536
MODEL_MIN_PRECISION=0.80
MODEL_MIN_RECALL=0.70
MODEL_MIN_F1=0.75
MODEL_MIN_PR_AUC=0.60
MODEL_MIN_LABEL_COUNT=500
MODEL_MIN_FRAUD_LABEL_COUNT=50

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8001
